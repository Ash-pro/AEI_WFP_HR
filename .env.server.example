# Server-only credentials. Never use the VITE_ prefix here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# One management credential is needed to apply SQL and deploy Edge Functions.
# Create a personal access token in the Supabase dashboard, and put it only in .env.server.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Confirm the actual initial tracking/service date before importing legacy seed records.
HR_IMPORT_STARTED_ON=
